# Copy to .env and fill in.  cp .env.example .env

# ---------------------------------------------------------------- domain / HTTPS
# Your domain (an A record pointing at the server). Used by the Caddy HTTPS profile.
DOMAIN=share.example.com
# Public address people open. Also used to build the Microsoft redirect URI.
PUBLIC_URL=https://share.example.com
# Behind Caddy / a load balancer: trust X-Forwarded-* headers for HTTPS detection and client IPs.
TRUST_PROXY=1
# Where the app container listens on the host. With the https profile keep it private:
APP_PORT=127.0.0.1:3000
# Without a domain (plain http://SERVER-IP:3000), use instead:
# APP_PORT=3000
# TRUST_PROXY=0
# PUBLIC_URL=

# ---------------------------------------------------------------- admin
# Bootstrap admin, created on first start. CHANGE THE PASSWORD after the first sign-in.
ADMIN_USER=Admin
ADMIN_PASSWORD=Aman@12@
# Set to 1 for one start to restore the admin account above (locked out / forgot password), then back to 0.
RESET_ADMIN=0

# ---------------------------------------------------------------- encryption
# 32-byte master key. Generate:  openssl rand -base64 32
# If empty, a key is generated into the data volume (data/secret.key) on first start.
# Losing this key means losing every file — keep a copy somewhere safe.
ENCRYPTION_KEY=

# ---------------------------------------------------------------- limits
# Max size per uploaded file in MB (0 = unlimited)
MAX_UPLOAD_MB=0
SESSION_DAYS=7

# ---------------------------------------------------------------- Microsoft Entra ID (optional)
# Leave MS_CLIENT_ID empty to configure Microsoft sign-in from Admin → Sign-in & security instead.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# common | organizations | consumers | <your tenant GUID>
MS_TENANT_ID=common
# Defaults to PUBLIC_URL + /auth/microsoft/callback
MS_REDIRECT_URI=
# 1 = new Microsoft users can sign in immediately; 0 = an admin approves them first
MS_AUTO_APPROVE=0
# Comma-separated list, e.g. contoso.com,fabrikam.com (empty = any)
MS_ALLOWED_DOMAINS=
