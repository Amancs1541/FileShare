{
  "name": "clover-x-file-share",
  "version": "2.0.0",
  "description": "Clover-X multi-user encrypted file sharing server with Microsoft sign-in",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "docker:up": "docker compose up -d --build",
    "docker:https": "docker compose --profile https up -d --build"
  },
  "engines": {
    "node": ">=18.15"
  }
}
